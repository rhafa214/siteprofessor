# ==========================================
# SERVER SECRETS
# ==========================================
# (Never add VITE_ prefix to these. In Cloud Functions, configure these via Firebase Secret Manager or Parameterized Configuration)

# GEMINI_API_KEY: Required for Gemini AI API calls.
# CONFIGURE VIA FIREBASE SECRET MANAGER for production Cloud Functions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AUTHORIZED_FIREBASE_UIDS: Lista de UIDs do Firebase permitidos para acessar a API separada por vírgula.
# Em Cloud Functions, defina via Parameterized Configuration (por exemplo, criando um arquivo functions/.env para uso local).
AUTHORIZED_FIREBASE_UIDS="user-uid-1,user-uid-2"

# ALLOWED_ORIGINS: Lista de origens permitidas para acessar a API separada por vírgula.
ALLOWED_ORIGINS="https://meu-app.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# CLIENT PUBLIC CONFIG
# ==========================================
# (VITE_ prefix is required for frontend access)

# VITE_GOOGLE_CLIENT_ID: Your Google OAuth Client ID for Calendar/Drive sync.
VITE_GOOGLE_CLIENT_ID=""
