# SERVER-SIDE ONLY (Nunca adicione VITE_ como prefixo)
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AUTHORIZED_FIREBASE_UIDS: Lista de UIDs do Firebase permitidos para acessar a API separada por vírgula.
AUTHORIZED_FIREBASE_UIDS="user-uid-1,user-uid-2"

# ALLOWED_ORIGINS: Lista de origens permitidas para acessar a API separada por vírgula.
ALLOWED_ORIGINS="https://meu-app.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLIENT-SIDE (Prefixo VITE_ é permitido e expõe a variável ao frontend)
# VITE_GOOGLE_CLIENT_ID: Your Google OAuth Client ID for Calendar/Drive sync.
VITE_GOOGLE_CLIENT_ID=""
